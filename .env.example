# Public settings only. Never put AWS credentials or AI keys here.

# Set to "true" to render the real (backend-connected) app instead of the demo prototype.
VITE_BACKEND_CONNECTED=false

# Base URL prepended to every API request. Leave empty for local dev — the vite dev
# server proxies /auth, /me, /groups, /invitations, /health to the deployed backend
# (see vite.config.ts). For a production build, set this to the real API Gateway URL.
VITE_API_BASE_URL=

# Override the local dev proxy target (defaults to the fcc-backend-dev API Gateway URL).
VITE_DEV_PROXY_TARGET=

# Explicit opt-in for a local production-demo build; NEVER enable in service production.
# npm run dev already enables the local prototype without this flag.
VITE_ENABLE_DEMO=false
