# Public settings only. Never put AWS credentials or AI keys here.

# 배포된 API 주소(예: API Gateway). 비워 두면 개발 서버(npm run dev)는 `/api` 프록시를 쓰고,
# 프로덕션 빌드는 "서비스 연결 준비 중" 화면을 보여줍니다. 배포 API는 CORS 허용 Origin에 이 앱 주소가 필요합니다.
VITE_API_BASE_URL=

# 개발 서버 프록시가 향할 로컬 백엔드 (fcc-backend: `pnpm start`, 기본 3000).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000
